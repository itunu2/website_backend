# ============================================
# CORE STRAPI CONFIGURATION (REQUIRED)
# ============================================
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Generate these with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="replace_me_1,replace_me_2,replace_me_3,replace_me_4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# For Supabase (Production):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
# For Local Development:
DATABASE_URL=postgres://itunus:change-me@localhost:5432/itunus
DATABASE_CLIENT=postgres
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Individual connection params (if not using DATABASE_URL)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=itunus
# DATABASE_USERNAME=itunus
# DATABASE_PASSWORD=change-me

# SQLite fallback (development only)
DATABASE_FILENAME=.tmp/data.db

# ============================================
# NETWORKING & SECURITY (REQUIRED FOR PROD)
# ============================================
# Comma-separated list of allowed origins
# Production: CORS_ORIGINS="https://your-domain.vercel.app,https://www.your-domain.com"
CORS_ORIGINS="http://localhost:3000"

# Your backend's public URL
# Production: PUBLIC_BASE_URL=https://your-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:1337

# ============================================
# SUPABASE STORAGE (RECOMMENDED FOR PRODUCTION)
# ============================================
# Required for production file uploads (Render's filesystem is ephemeral).
# Uploads use Supabase's S3-compatible protocol with dedicated S3 access keys.
# This is independent of the anon/service_role/sb_secret API keys and does NOT
# expire with the end-of-2026 legacy key deprecation.
#
# Generate the credentials at:
#   Supabase Dashboard → Storage → S3 Connection (the S3 configuration page)
#   → enable the connection, then "New access key" to create an Access Key ID
#   + Secret Access Key. Copy the Endpoint and Region shown on that page.
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=strapi-uploads
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Legacy/REST key — no longer used for storage uploads. Optional.
SUPABASE_SERVICE_ROLE_KEY=
# Maximum upload file size in MB (applies to parser + provider)
UPLOAD_MAX_FILE_SIZE_MB=25

# ============================================
# REDIS CACHING (OPTIONAL)
# ============================================
REDIS_URL=
CACHE_TTL_SECONDS=300

# ============================================
# RENDER SELF-PING (RECOMMENDED FOR PRODUCTION)
# ============================================
# Keeps Render free tier from spinning down due to inactivity
# Set to true in production to ping health endpoint every 5-8 minutes (hardcoded)
# Production: SELF_PING_ENABLED=true
SELF_PING_ENABLED=false
