# ============================================
# CORE STRAPI CONFIGURATION (REQUIRED)
# ============================================
NODE_ENV=development
HOST=0.0.0.0
PORT=1337

# Generate these with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="replace_me_1,replace_me_2,replace_me_3,replace_me_4"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# For Supabase (Production):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
# For Local Development:
DATABASE_URL=postgres://itunus:change-me@localhost:5432/itunus
DATABASE_CLIENT=postgres
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Alternative: Individual connection params (if not using DATABASE_URL)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=itunus
# DATABASE_USERNAME=itunus
# DATABASE_PASSWORD=change-me

# SQLite fallback (development only)
DATABASE_FILENAME=.tmp/data.db

# ============================================
# NETWORKING & SECURITY (REQUIRED FOR PROD)
# ============================================
# Comma-separated list of allowed origins
# Production: CORS_ORIGINS="https://your-domain.vercel.app,https://www.your-domain.com"
CORS_ORIGINS="http://localhost:3000"

# Your backend's public URL
# Production: PUBLIC_BASE_URL=https://your-backend.onrender.com
PUBLIC_BASE_URL=http://localhost:1337

# ============================================
# AWS S3 MEDIA STORAGE (OPTIONAL BUT RECOMMENDED)
# ============================================
# Required for production file uploads (Render's filesystem is ephemeral)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_ACL=public-read
AWS_CDN_BASE_URL=

# ============================================
# REDIS CACHING (OPTIONAL)
# ============================================
REDIS_URL=
CACHE_TTL_SECONDS=300

# ============================================
# RENDER SELF-PING (RECOMMENDED FOR PRODUCTION)
# ============================================
# Keeps Render free tier from spinning down due to inactivity
# Set to true in production to ping health endpoint every N minutes
# Production: SELF_PING_ENABLED=true
SELF_PING_ENABLED=false
SELF_PING_INTERVAL_MINUTES=10
