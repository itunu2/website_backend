HOST=0.0.0.0
PORT=1337
APP_KEYS="replace_me_1,replace_me_2"
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (configure a persistent Postgres/MySQL instance)
DATABASE_URL=postgres://itunus:change-me@localhost:5432/itunus
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=itunus
DATABASE_USERNAME=itunus
DATABASE_PASSWORD=change-me
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_FILENAME=.tmp/data.db

# Networking & security
CORS_ORIGINS="http://localhost:3000"

# AWS S3 (optional, enables upload provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=
AWS_ACL=public-read
AWS_CDN_BASE_URL=

# Redis / caching (optional)
REDIS_URL=
CACHE_TTL_SECONDS=300

# Self-ping scheduler
SELF_PING_ENABLED=false
SELF_PING_INTERVAL_MINUTES=10
PUBLIC_BASE_URL=http://localhost:1337
